{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velox Setup",
  "version": "1.0.0",
  "identifier": "dev.velox.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Velox Setup",
        "width": 560,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
